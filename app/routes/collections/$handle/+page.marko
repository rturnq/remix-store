<const/{ canonicalUrl, collection }=$global.data>
<app-document
  canonicalUrl=canonicalUrl
  title=collection.title
  description=collection.description
  socialImage="/social-collections.jpg"
>
  <main>
    <page-title title=collection.title/>
    <if=collection.products.nodes.length>
      <product-grid
        collectionHandle=collection.handle
        pathPrefix=$global.platform.market.pathPrefix
        products=collection.products.nodes
        pageInfo=collection.products.pageInfo
      />
    </if>
    <else>
      <p style="margin:0;min-height:45vh;padding:64px 20px;text-align:center">
        No products found in this collection.
      </p>
    </else>
  </main>
</app-document>
