{
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "@shopify/oxygen-workers-types"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@shopify/hydrogen/ts-plugin"
      }
    ],
    "noEmit": true
  },
  "include": ["app", "vite", "*.ts", ".marko-run/routes.d.ts"],
  "exclude": ["dist", "legacy"]
}
