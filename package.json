{
  "name": "remix-store",
  "version": "2024.4.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "marko-run dev --port 44100 --env .env server.node.ts",
    "dev:oxygen": "marko-run dev --config vite.oxygen.config.ts --port 44100 app/entry.oxygen.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/index.mjs",
    "build": "marko-run build server.node.ts",
    "build:oxygen": "marko-run build --config vite.oxygen.config.ts app/entry.oxygen.ts",
    "preview": "marko-run preview --port 44100 --env .env server.node.ts",
    "preview:oxygen": "marko-run preview --config vite.oxygen.config.ts --port 44100 app/entry.oxygen.ts",
    "deploy": "pnpm deploy:oxygen",
    "deploy:oxygen": "shopify hydrogen deploy --preview --build-command 'pnpm build:oxygen'",
    "lint": "oxlint . && oxfmt --check . && prettier --check \"app/**/*.marko\"",
    "typecheck": "node scripts/generate-route-types.mjs && mtc && hydrogen gql check --fail-on-warn && node scripts/check-admin-graphql.mjs",
    "format": "oxfmt . && prettier --write \"app/**/*.marko\"",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:oxygen": "pnpm build:oxygen && E2E_RUNTIME=oxygen-preview playwright test",
    "test:e2e:oxygen:dev": "E2E_RUNTIME=oxygen-dev playwright test"
  },
  "dependencies": {
    "@marko/run": "0.11.13",
    "@shopify/hydrogen": "2026.10.0-preview.4",
    "marko": "6.4.4",
    "remix": "3.0.0",
    "sanitize-html": "2.18.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@marko/run-adapter-node": "2.0.6",
    "@marko/testing-library": "6.4.2",
    "@marko/type-check": "3.2.1",
    "@marko/vite": "6.1.13",
    "@shopify/cli": "4.9.0",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@types/node": "24.19.0",
    "@types/sanitize-html": "2.16.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.0.3",
    "gql.tada": "1.9.2",
    "graphql": "16.14.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-marko": "4.1.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "overrides": {
      "undici": "7.30.0",
      "qs": "6.16.0",
      "ws": "8.22.0",
      "cookie": "1.1.1"
    }
  }
}
